# --- GERAL & OS ---
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- NODE.JS (Dependências) ---
node_modules/
*/node_modules/

# --- VARIÁVEIS DE AMBIENTE & SEGREDOS (CRÍTICO) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example

# --- TERRAFORM (Infraestrutura) ---
# Ignora arquivos de estado locais (contêm segredos!)
*.tfstate
*.tfstate.*
infra/tf-state
# Ignora a pasta de plugins baixados
.terraform/
# Ignora tfvars com segredos (credenciais, tokens)
# Os tfvars de ambiente (env/*.tfvars) são commitados pois não têm segredos
*.tfvars.secret
# Ignora o arquivo de backend config local (contém bucket name e perfil)
infra/backend.hcl
# Exceção: Arquivos de exemplo e tfvars de ambiente são commitados
!infra/env/*.tfvars
!*.tfvars.example
!backend.hcl.example
# Logs de crash
crash.log
override.tf
override.tf.json
.terraform.lock.hcl

# --- BACKEND (Builds & Artefatos) ---
# Ignora os zips gerados que vão para o S3/Lambda
infra/builds/*.zip
infra/builds/*.js
# Ignora a pasta de transpilacão temporária do esbuild
backend/dist/

# --- FRONTEND (Next.js & OpenNext) ---
.next/
out/
build/
dist/
.open-next/
# Cache do Next.js
.vercel/

# --- ADMIN (Vue.js / Vite) ---
admin/dist/
admin/coverage/
*.local

# --- CLAUDE CODE (Configurações locais do usuário) ---
.claude/settings.local.json

# --- IDEs (Configurações locais) ---
.vscode/
.idea/
*.swp
*.swo

# --- AWS / SERVERLESS ---
.serverless/
.aws-sam/