# --- GERAL & OS ---
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- NODE.JS (Dependências) ---
node_modules/
*/node_modules/

# --- VARIÁVEIS DE AMBIENTE & SEGREDOS (CRÍTICO) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# --- TERRAFORM (Infraestrutura) ---
# Ignora arquivos de estado locais (contêm segredos!)
*.tfstate
*.tfstate.*
# Ignora a pasta de plugins baixados
.terraform/
# Ignora arquivos de variáveis com valores reais
*.tfvars
# Exceção: Se quiser commitar um exemplo (renomeie seus arquivos para .example)
!*.tfvars.example
# Logs de crash
crash.log
override.tf
override.tf.json
.terraform.lock.hcl

# --- BACKEND (Builds & Artefatos) ---
# Ignora os zips gerados que vão para o S3/Lambda
infra/builds/*.zip
infra/builds/*.js
# Ignora a pasta de transpilacão temporária do esbuild
backend/dist/

# --- FRONTEND (Next.js & OpenNext) ---
.next/
out/
build/
dist/
.open-next/
# Cache do Next.js
.vercel/

# --- ADMIN (Vue.js / Vite) ---
admin/dist/
admin/coverage/
*.local

# --- IDEs (Configurações locais) ---
.vscode/
.idea/
*.swp
*.swo

# --- AWS / SERVERLESS ---
.serverless/
.aws-sam/