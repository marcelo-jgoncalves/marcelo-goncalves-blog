# Copy to backend.hcl (gitignored) and fill in values for local dev.
# CI/CD passes these via -backend-config flags directly.
#
# Usage:
#   terraform init -backend-config=backend.hcl -var-file=env/dev.tfvars

bucket       = "marcelo-goncalves-blog-dev-tfstate"
key          = "blog/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
profile      = "claude-dev"
