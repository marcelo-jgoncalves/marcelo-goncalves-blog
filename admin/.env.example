# Variáveis de ambiente para desenvolvimento local do admin
# Copie este arquivo para .env.local e preencha os valores

# URL base da API Gateway (mesma do frontend, ambiente dev)
VITE_API_BASE_URL=https://5duus31al8.execute-api.us-east-1.amazonaws.com/v1

# Cognito — obrigatório para o Amplify Auth inicializar.
# Obter via: cd infra && terraform output cognito_user_pool_id
VITE_COGNITO_USER_POOL_ID=

# Obter via: cd infra && terraform output cognito_client_id
VITE_COGNITO_CLIENT_ID=

# URL do CloudFront do frontend (usada para montar URLs de asset/preview)
VITE_ASSETS_URL=https://dsns2wusdrj9z.cloudfront.net
