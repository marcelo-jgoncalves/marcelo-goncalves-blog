{
  "agent_mode": "autonomous",
  "cycle_model": "Detect → Analyze → Plan → Implement → Validate → Commit → Observe → Repeat",
  "commit_convention": "conventional_commits",
  "github": {
    "required_scopes": [
      "repo",
      "workflow",
      "read:org",
      "actions:read"
    ],
    "cli_capabilities": [
      "gh run list",
      "gh run view",
      "gh run watch",
      "gh pr create",
      "gh pr list",
      "gh pr view",
      "gh secret set",
      "gh variable set",
      "gh workflow run",
      "gh repo view",
      "gh api"
    ],
    "justification": "Required for autonomous repository evolution, CI/CD orchestration, PR lifecycle management, workflow execution, diagnostics and organizational policy awareness."
  },
  "aws": {
    "access_level": "least-privilege",
    "preferred_auth": "OIDC via GitHub Actions (no long-lived credentials)",
    "profile_local": "devops-blog-dev",
    "required_permissions": [
      "sts:GetCallerIdentity",
      "s3:ListBucket",
      "s3:GetObject",
      "lambda:ListFunctions",
      "lambda:GetFunction",
      "lambda:GetFunctionConfiguration",
      "logs:DescribeLogGroups",
      "logs:GetLogEvents",
      "logs:FilterLogEvents",
      "cloudwatch:DescribeAlarms",
      "cloudwatch:GetMetricData",
      "xray:GetTraceSummaries",
      "xray:BatchGetTraces",
      "dynamodb:ListTables",
      "dynamodb:DescribeTable",
      "apigateway:GET",
      "cloudfront:GetDistribution",
      "cloudfront:ListDistributions",
      "cloudformation:DescribeStacks",
      "cloudformation:ListStacks",
      "ecs:DescribeServices",
      "ecs:ListServices",
      "cognito-idp:DescribeUserPool",
      "cognito-idp:ListUserPools"
    ],
    "deploy_permissions": [
      "s3:PutObject",
      "s3:DeleteObject",
      "lambda:UpdateFunctionCode",
      "lambda:UpdateFunctionConfiguration",
      "cloudfront:CreateInvalidation",
      "iam:PassRole"
    ],
    "deploy_constraints": {
      "iam_passrole_scope": "terraform execution role only",
      "write_permissions_only_in_ci": true,
      "deploy_role": "GitHubActions-Terraform-Role-Dev"
    },
    "note": "Infrastructure validation must default to read-only operations. Write permissions are allowed only inside controlled CI deploy jobs."
  },
  "local_environment": {
    "required_tools": [
      "git>=2.40",
      "gh>=2.40",
      "aws-cli>=2.0",
      "node>=20",
      "npm>=10",
      "terraform>=1.8",
      "docker",
      "zip",
      "playwright",
      "chromium"
    ],
    "capabilities": [
      "shell_execution",
      "dependency_installation",
      "container_execution",
      "local_server_execution",
      "test_execution",
      "headless_browser_validation"
    ]
  },
  "autonomous_capabilities": [
    "audit_repository",
    "create_ci_pipeline",
    "fix_pipeline_failures",
    "run_security_scans",
    "update_dependencies",
    "generate_tests",
    "refactor_code",
    "validate_builds",
    "validate_deployments",
    "observe_production",
    "analyze_logs",
    "detect_regressions",
    "perform_incremental_improvements",
    "maintain_project_context"
  ],
  "quality_gates": {
    "before_commit": [
      "build",
      "lint",
      "typecheck",
      "tests"
    ],
    "coverage_target": 80,
    "pipeline_must_be_green": true,
    "requirements": [
      "code_must_compile",
      "tests_must_pass",
      "no_security_warnings_high",
      "lint_clean",
      "typecheck_clean"
    ]
  },
  "observability_requirements": [
    "structured_logging",
    "centralized_logs",
    "metrics_visibility",
    "tracing_enabled",
    "error_tracking",
    "healthchecks"
  ],
  "security_principles": [
    "least_privilege",
    "auditability",
    "no_long_lived_secrets",
    "oidc_for_ci_cd",
    "read_only_by_default",
    "explicit_write_permissions",
    "no_secrets_in_code",
    "zero_trust"
  ],
  "operating_constraints": {
    "no_destructive_actions_without_confirmation": true,
    "no_global_admin_permissions": true,
    "prefer_read_only_operations": true,
    "require_reversible_changes": true,
    "protect_persistent_data": true,
    "never_expose_secrets": true
  },
  "self_driving_objective": {
    "goal": "Transform the repository into a continuously evolving self-driving engineering system.",
    "success_signals": [
      "pipeline_always_green",
      "automated_issue_detection",
      "continuous_improvement_cycles",
      "stable_deployments",
      "updated_project_context",
      "high_test_coverage",
      "observable_system_behavior"
    ]
  }
}