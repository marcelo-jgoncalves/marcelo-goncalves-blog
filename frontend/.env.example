# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env.local e preencha os valores

# URL da API Gateway (backend AWS) — obrigatório para rodar localmente
API_URL=https://5duus31al8.execute-api.us-east-1.amazonaws.com/v1

# URL base do site — use localhost em dev para canonicals corretos
# Em produção é configurada via Terraform (NEXT_PUBLIC_SITE_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
