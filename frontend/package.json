    "audit:engenharia-de-software": "playwright test e2e/visual-audit/engenharia-de-software.audit.spec.ts",
    "audit:cloud-devops": "playwright test e2e/visual-audit/cloud-devops.audit.spec.ts",
    "audit:integracao-automacao": "playwright test e2e/visual-audit/integracao-automacao.audit.spec.ts",
